# Copy to .env and edit. .env is gitignored — never commit it.

# --- Pinned versions (bump deliberately, not automatically) ---
WP_VERSION=7.1.2
WC_VERSION=11.1.2

# --- Database ---
DB_NAME=cafebean
DB_USER=cafebean
DB_PASSWORD=change-me-locally
DB_ROOT_PASSWORD=change-me-locally-too
DB_TABLE_PREFIX=cb_

# --- Site ---
WP_URL=http://localhost:8987
WP_PORT=8987
WP_TITLE=کافه‌بین
WP_LOCALE=fa_IR
WP_DEBUG=1

# --- Admin (used by scripts/setup.sh) ---
WP_ADMIN_USER=cafebean_admin
WP_ADMIN_PASSWORD=change-me-locally
WP_ADMIN_EMAIL=admin@cafebean.test

# --- Zarinpal (sandbox only; the demo never takes real payments) ---
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=1

# --- Linear (project tracking; not used by the site) ---
LINEAR_API_KEY=
